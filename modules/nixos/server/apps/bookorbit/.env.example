# Copy to /srv/docker/bookorbit/.env and replace every secret before starting the stack.
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest
APP_PORT=3200
PORT=3000
BOOKS_HOST_PATH=./books
PUID=1000
PGID=1000
POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
SETUP_BOOTSTRAP_TOKEN=change-me
APP_URL=https://bookorbit.tail6164c3.ts.net
NODE_MAX_OLD_SPACE_SIZE=2048

# Optional overrides:
# DATABASE_URL=
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# CLIENT_URL=https://bookorbit.tail6164c3.ts.net
# BOOK_DOCK_PATH=
# LIBRARY_BROWSE_ROOT=/books
# BOOKORBIT_FIX_PERMISSIONS=true
# EMAIL_ENCRYPTION_KEY=
# MIGRATION_ENCRYPTION_KEY=
# MIGRATION_IMPORT_ROOT=/imports
# LOG_LEVEL=info
# OIDC_ALLOW_LOCAL_ISSUERS=false
# CSP_ALLOW_CLOUDFLARE_INSIGHTS=false
